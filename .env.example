# Copy to .env (or export these) to override the defaults. All optional for local use.

# Sessions are signed with this. If unset, a random key is created in instance/secret_key.
SECRET_KEY=

# Default admin account, created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@hospital.com

# Database (defaults to instance/hospital.db)
# DATABASE_URL=sqlite:///hospital.db

# Server
PORT=5001
# FLASK_DEBUG=1
